# Copy to .env and fill in. Never commit .env (it holds the bot token).
BOT_TOKEN=
TARGET_CHAT_ID=
# channel/group id the bot posts to, e.g. -1001234567890 (bot must be admin there).
# Or a @channelusername if the bot is admin of that channel.
CONFIG_PATH=config.yaml
# config.yaml = black backdrops only (ready to run, no model picks needed).
# config-rare.yaml = black backdrops + top-3 rarest models per gift (starter picks).
STATE_PATH=state.json
POLL_SECONDS=90
